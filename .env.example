# =============================================================================
# Retina AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env (or backend/.env) and populate with your own values.
# NEVER commit real credentials, passwords, or tokens to version control.
# =============================================================================

# Application Settings
APP_NAME=Retina AI API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
# Required production environment variable on Render. Use safe placeholders locally.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=retina_ai

# Optional direct connection string (if SRV DNS resolution is restricted)
# MONGODB_FALLBACK_URI=mongodb://USERNAME:PASSWORD@HOST-0:27017,HOST-1:27017,HOST-2:27017/retina_ai?ssl=true&authSource=admin&replicaSet=YOUR_REPLICA_SET

# AI Model Checkpoint Weights
MODEL_PATH=models/retina_project_v4_best.pth

# Image Upload & Report Storage Constraints
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
GRADCAM_DIR=gradcam
REPORTS_DIR=reports

# Frontend API Configuration (for React / Vite frontend)
VITE_API_URL=http://localhost:8000
